<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="edu.qust.userDao.mapper.ProductRatingMapper">

    <insert id="insertBatchIgnore" parameterType="java.util.ArrayList">
        insert ignore into product_rating (
            user_id,
            product_id,
            score,
            rating_time)
        values
        <foreach collection="list" item="item" index="index" separator=",">
            (#{item.userId},#{item.productId},#{item.score},#{item.time})
        </foreach>
    </insert>
</mapper>
